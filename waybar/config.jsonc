{
	"spacing": 7,
	"margin-top": 10,
	// "margin-bottom": 10,

	"modules-center": ["hyprland/workspaces", "clock", "pulseaudio","battery"],

	"clock": {
		"interval":60,
		"format":"{:%I:%M}",
		"tooltip-format": "{:%A, %m/%d/%Y}"
	},


	"hyprland/workspaces": {
		"format": "{icon}",
		"on-click": "activate",
		"format-icons": {
			"active": "",
			"default": "",
		},
		"persistent-workspaces": {
			"*": 5
		}
	},


	"pulseaudio": {
		"format": "{volume}% {icon}",
		"format-bluetooth": "{volume}% ",
		"format-muted": "",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"phone-muted": "",
			"portable": "",
			"car": "",
			"default": [
				" ",
				" ",
				" "
			]
		},
		"scroll-step": 1,
		"on-click": "pavucontrol",
		"ignored-sinks": ["Easy Effects Sink"]
	},

	"network": {
		"interface": "wlo1",
		"format": "{ifname}",
		"format-wifi": "{essid}  ",
		"format-ethernet": "{ipaddr}/{cidr} 󰊗",
		"format-disconnected": "", //An empty format will hide the module.
		"tooltip-format": "{ifname} via {gwaddr} 󰊗",
		"tooltip-format-wifi": "{essid} ({signalStrength}%) ",
		"tooltip-format-ethernet": "{ifname} ",
		"tooltip-format-disconnected": "Disconnected",
		"max-length": 50
	},

	"battery": {
		"format": "{capacity}",
		"states": {
			"warning": 30,
			"critical": 15,
		}
	}

}
